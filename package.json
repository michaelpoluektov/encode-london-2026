{
  "name": "shadily",
  "version": "0.0.1",
  "private": true,
  "description": "LLM-enabled shader editor desktop app scaffold.",
  "type": "module",
  "packageManager": "bun@1.3.3",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:with-devtools": "sh -c 'react-devtools >/tmp/shadily-react-devtools.log 2>&1 & devtools_pid=$!; trap \"kill $devtools_pid\" EXIT; ENABLE_REACT_DEVTOOLS=true electron-vite dev'",
    "build": "electron-vite build",
    "start": "electron-vite preview --skipBuild",
    "dist": "bun run build && electron-builder",
    "dist:dir": "bun run build && electron-builder --dir",
    "react-devtools": "react-devtools",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "build": {
    "appId": "com.encode-london.shadily",
    "productName": "Shadily",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@openai/codex-sdk": "latest",
    "monaco-editor": "^0.52.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.8.1",
    "electron-vite": "^4.0.0",
    "react-devtools": "^7.0.1",
    "typescript": "^5.9.3"
  }
}
